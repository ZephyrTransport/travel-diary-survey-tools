# Copy this file to .env and fill in the values for your machine.
# .env is gitignored and must not be committed.

CENSUS_KEY=abc*add*your*own*key*here*123

# --- Roots -------------------------------------------------------------------
#
# A root says where a shared location is mounted on THIS machine. The project
# configs build every path from one, so only these differ between machines --
# everything below a root is the same for everyone and stays in the config.
#
# Prefer UNC to a mapped drive letter: a UNC path resolves identically on every
# machine, a drive letter only resolves where someone has mapped it, and on
# Linux there are no drive letters at all.
#
# The pipeline names any root it needs and cannot find, before it starts, so you
# do not have to work out in advance which of these you need.

# MTC model data share. Mapped to M: on many MTC Windows machines --
# note the path ends in \models, which M: hides.
MTC_DATA=\\models.ad.mtc.ca.gov\data\models

# Model3A share, holding externally supplied survey weights. Mapped to X:.
# Only bats_2023 uses this.
MODEL3A_SHARE=\\model3-a\Model3A-Share

# Your local Box sync of "Modeling and Surveys". Pipeline output is written
# beneath this.
BOX_DIR=E:/Box/Modeling and Surveys

# Your clones of the model repositories, for zone shapefiles.
TM1_CLONE=E:/GitHub/travel-model-one
TM2PY_UTILS_CLONE=E:/GitHub/tm2py-utils
