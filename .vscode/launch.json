    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: 2023 Pipeline",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "projects/bats_2023/run.py",
            "console": "integratedTerminal",
            "args": []
        },
        {
            "name": "Python Debugger: 2019 Pipeline",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "projects/bats_2019/run.py",
            "console": "integratedTerminal",
            "args": []
        }
    ]
}
